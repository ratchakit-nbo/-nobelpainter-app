                                        -0.44362446665764, -2.9872644802253e-08, 0.89621275663376)
                                )
                            end)
                            task.wait(chopDelay)
                        end
                    end)
                end
            end
        end
    end

    local tool = getAxeTool()
    if tool then unequipTool(tool) end
end

